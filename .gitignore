# ============================================================
# ONEST Platform - Production .gitignore
# Security First: Ignore secrets, binaries, dependencies, logs
# ============================================================

# Environments & Secret Configurations
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.cer
*.crt

# Java / Maven Build Outputs
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Node / Frontend Dependencies & Builds
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor Configurations
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Logs & Temporary Files
logs/
*.log
*.tmp
*.bak
*.swp
*.swo

# Local agent tooling, binaries, and DB backups
.agent/
*.exe
*.dump
*_backup.sql
